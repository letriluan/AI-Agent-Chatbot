# Copy this file to .env and supply your own Groq API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Run commands from the repository root.
DB_PATH=db/app.sqlite
CACHE_DB=db/cache.sqlite
CACHE_TTL_SECONDS=3600

# Query result limits and execution timeout (seconds).
SQL_MAX_ROWS=50
SQL_TIMEOUT_SECONDS=2.0

# Optional LangSmith tracing: enable only when configured.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-database-agent
# Keep trace content hidden, even when tracing is enabled.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
